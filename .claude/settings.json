{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push:* --force-with-lease)",
      "Bash(rm -rf /:*)",
      "Bash(gh pr merge:*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./Gdocs-tabs*/credentials.json)",
      "Read(./Gdocs-tabs*/token.json)",
      "Read(./Gdocs-tabs*/config*.json)"
    ],
    "ask": [
      "Bash(git push origin main:*)",
      "Bash(uv add:*)",
      "Bash(uv pip install:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)",
      "Bash(ollama run:*)",
      "Bash(ollama pull:*)",
      "Bash(backend/.venv/bin/python -m cli.main crawl:*)",
      "Bash(backend/.venv/bin/python -m cli.main research:*)",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/protect_main.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/stop_on_red.sh\""
          }
        ]
      }
    ]
  }
}
